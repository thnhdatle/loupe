#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Repo-local pre-commit checks: gofumpt, golangci-lint on new code, gitleaks on
# staged changes.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

gofiles="$(git diff --cached --name-only --diff-filter=ACM -- '*.go')"
if [[ -n "$gofiles" ]]; then
  # shellcheck disable=SC2086 # file names in this repo contain no whitespace
  unformatted="$(go tool gofumpt -l $gofiles)"
  if [[ -n "$unformatted" ]]; then
    echo "pre-commit: gofumpt needed on:" >&2
    echo "$unformatted" >&2
    exit 1
  fi
  golangci-lint run --new-from-rev=HEAD
fi

gitleaks protect --staged --redact --no-banner
