#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Enforces the one-line Conventional Commit format "<type>(<scope>): <summary>".
set -euo pipefail

file="${1:?usage: commit-msg <message-file>}"
# Ignore comment lines and trailing blank lines added by git.
msg="$(awk '/^#/ {next} {lines[++n]=$0} END {while (n > 0 && lines[n] == "") n--; for (i = 1; i <= n; i++) print lines[i]}' "$file")"

if [[ "$(printf '%s\n' "$msg" | wc -l | tr -d ' ')" != "1" ]]; then
  echo "commit-msg: message must be exactly one line (no body, footer or trailers)" >&2
  exit 1
fi

re='^(feat|fix|perf|refactor|test|docs|build|ci|chore)(\([a-z0-9-]+\))?!?: [a-z0-9].{0,70}[^.]$'
if ! [[ "$msg" =~ $re ]]; then
  echo "commit-msg: '$msg' does not match <type>(<scope>): <summary>" >&2
  echo "  types: feat fix perf refactor test docs build ci chore; <= 72 chars; no trailing period" >&2
  exit 1
fi
